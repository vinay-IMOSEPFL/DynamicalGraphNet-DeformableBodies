# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env

# --- IDE ---
.vscode/
.idea/
*.swp

# --- Checkpoints ---
# Excluded by default. The two checkpoints that reproduce the reported numbers are
# re-included below; they are small enough to ship.
**/saved_models/*
*.pth
*.ckpt
!case_01_human_walk/saved_models/Val_Loss_0.40821mm_iter598.pth
!case_03_nbody/saved_models/Val_Loss_0.01626mm_iter590.pth

# --- Data ---
# Raw trajectories are downloaded or generated, never committed. The exception is the
# human walk split files: they fix which frames are drawn, so the reported errors are
# only reproducible if they ship.
case_01_human_walk/data/*
case_03_nbody/data_*/
*.pkl
*.npy
*.pt
*.h5
*.pdb
*.dcd
# Re-included after the blanket rules above, which would otherwise win on suffix.
!case_01_human_walk/data/split_n1.pkl
!case_01_human_walk/data/split_n2.pkl
!case_01_human_walk/data/split_n3.pkl

# --- Results ---
# Run outputs are excluded; the figures the README embeds live in docs/assets.
**/results/
*.png
*.jpg
*.gif
*.mp4
!docs/assets/*.png
!docs/assets/*.gif

# --- Scratch ---
# Training/eval working directories, not part of the release.
_runs/

# --- Logs ---
*.log
*.err
events.out.tfevents.*

# --- System ---
.DS_Store
Thumbs.db
